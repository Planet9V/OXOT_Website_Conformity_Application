{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "seed": "node ./build.seed.mjs && node --enable-source-maps ./dist/seed.mjs",
    "seed:conformity": "node ./build.seedConformity.mjs && node --enable-source-maps ./dist/seedConformity.mjs",
    "seed:demo": "node ./build.seedDemo.mjs && node --enable-source-maps ./dist/seedDemo.mjs",
    "seed:content": "node ./build.seedContent.mjs && node --enable-source-maps ./dist/seedContent.mjs",
    "seed:customer-site": "node ./build.seedCustomerSite.mjs && node --enable-source-maps ./dist/seedCustomerSite.mjs",
    "seed:site": "node ./build.seedSiteSnapshot.mjs && node --enable-source-maps ./dist/seedSiteSnapshot.mjs",
    "content:export": "node ./build.exportSiteContent.mjs && node --enable-source-maps ./dist/exportSiteContent.mjs",
    "alerts:run": "node ./build.alerts.mjs && node --enable-source-maps ./dist/runConformityAlerts.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.21.0",
    "@react-pdf/renderer": "^4.5.1",
    "@replit/connectors-sdk": "^0.4.1",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "fast-xml-parser": "^5.10.1",
    "google-auth-library": "^10.9.0",
    "marked": "^18.0.6",
    "nodemailer": "^9.0.3",
    "openai": "^6.46.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "react": "catalog:"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/nodemailer": "^8.0.1",
    "esbuild": "0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0",
    "vitest": "^4.1.10"
  }
}
