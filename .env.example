# Environment template for the OXOT Website Conformity Application.
#
# Copy to .env and fill in real values:   cp .env.example .env
#
# .env itself is gitignored and MUST stay that way — it holds live secrets.
# This file exists so the required key names survive even if .env does not.
# It carries names only. Never commit a value here.

# --- Application ---

# Signs admin session cookies. Any long random string; rotating it logs
# everyone out. Generate with: openssl rand -hex 32
SESSION_SECRET=

# Admin login for the conformity workbench. docker-compose defaults the
# username to "admin"; the password has no default and compose refuses to
# start without it.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# --- Database ---

# Password for the bundled Postgres (pgvector) service. This project runs its
# OWN database — it is never shared with another OXOT stack.
POSTGRES_PASSWORD=

# --- AI services ---

# OpenAI-compatible endpoint used by the assistant surfaces.
AI_INTEGRATIONS_OPENAI_BASE_URL=
AI_INTEGRATIONS_OPENAI_API_KEY=

# Embeddings for retrieval over the statutory corpora. Without it, embedding
# generation fails with "OPENROUTER_API_KEY must be set in database or
# environment" — which is what several integration tests currently hit in CI.
OPENROUTER_API_KEY=
