# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
build/
.next/
out/

# Environment and secrets
.env
.env.local
.env.production
.env.development
*.pem

# Database and SQLite temporary files
*.sqlite
*.db
sqlite.db*

# Logs and runtime artifacts
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Zip archives, PDFs, 3D assets, and large binaries
*.zip
*.tar.gz
*.tgz
*.pdf
*.obj
attached_assets/
assets/oxot-uploads/
# The source-library documents are content the app serves — always tracked.
!artifacts/conformity/public/sources/*.pdf
test-models.js
test-*.js

# OS and IDE files
.DS_Store
Thumbs.db
.vscode/
.idea/

# Coverage and test artifacts
coverage/
.vitest/

# Local browser-automation session artifacts and ad-hoc verification screenshots
.playwright-mcp/
/*.png

# Superpowers brainstorm mockups (local, ephemeral)
.superpowers/
.claude/
.claude-flow/

# TypeScript incremental build state. Committing it makes `tsc -b` no-op on a
# fresh clone where dist/ is ignored, so consumers cannot resolve project
# references and typecheck fails with TS6305.
*.tsbuildinfo
artifacts_verify/

# Editor workspace files and stray local scratch dirs (not project sources)
*.code-workspace
/images/
